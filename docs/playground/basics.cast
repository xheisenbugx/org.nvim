[0,"o","\u001b[1;1H\u001b[0m#+TITLE:\u001b[0;1m org.nvim tutor 1: the basics\u001b[0m \u001b[0;38;2;155;158;164m ✓ 0/14\u001b[0m\u001b[K\u001b[2;1H\u001b[0m#+STARTUP:\u001b[0;38;2;179;246;192m showall nologdone\u001b[0m\u001b[K\u001b[3;1H\u001b[0m#+TODO:\u001b[0;38;2;179;246;192m TODO | DONE\u001b[0m\u001b[K\u001b[4;1H\u001b[K\u001b[5;1H\u001b[0mWelcome to org.nvim! This is a working copy of the tutor, a normal org\u001b[K\u001b[6;1H\u001b[0mfile: every key of org.nvim works here, and you learn by doing.\u001b[K\u001b[7;1H\u001b[K\u001b[8;1H\u001b[0;38;2;140;248;247m-\u001b[0m Each lesson below has exercises: the headlines that start with a\u001b[K\u001b[9;1H\u001b[0m  number such as \u001b[0;38;2;179;246;192m=1.2=\u001b[0m. When you have done one, a ✓ appears at the\u001b[K\u001b[10;1H\u001b[0m  end of its headline; until then it shows ✗. The first line counts\u001b[K\u001b[11;1H\u001b[0m  how many you have done.\u001b[K\u001b[12;1H\u001b[0;38;2;140;248;247m-\u001b[0m Keys are shown as they are mapped in your config. \u001b[0;38;2;179;246;192m=<leader>=\u001b[0m is your\u001b[K\u001b[13;1H\u001b[0m  leader key, \u001b[0;38;2;179;246;192m=<Space>=\u001b[0m. \u001b[0;38;2;179;246;192m=<M-x>=\u001b[0m means Alt+x, \u001b[0;38;2;179;246;192m=<S-x>=\u001b[0m Shift+x and\u001b[K\u001b[14;1H\u001b[0m  \u001b[0;38;2;179;246;192m=<C-x>=\u001b[0m Ctrl+x.\u001b[K\u001b[15;1H\u001b[0;38;2;140;248;247m-\u001b[0m Nothing you do here touches your notes. Make a mess if you like: \u001b[0;38;2;179;246;192m=u=\u001b[0m\u001b[K\u001b[16;1H\u001b[0m  undoes, \u001b[0;38;2;179;246;192m=:w=\u001b[0m saves your progress, and \u001b[0;38;2;179;246;192m=:Org tutor basics reset=\u001b[0m starts\u001b[K\u001b[17;1H\u001b[0m  the lesson over. \u001b[0;38;2;179;246;192m=:Org tutor=\u001b[0m brings you back here later.\u001b[K\u001b[18;1H\u001b[0;38;2;140;248;247m-\u001b[0m \u001b[0;38;2;179;246;192m=g?=\u001b[0m lists every key of an org buffer, any time.\u001b[K\u001b[19;1H\u001b[K\u001b[20;1H\u001b[0mMove down with \u001b[0;38;2;179;246;192m=j=\u001b[0m to start.\u001b[K\u001b[21;1H\u001b[K\u001b[22;1H\u001b[0;48;2;79;82;88m basics.org                                                                 1:1 \u001b[0m\u001b[K\u001b[23;1H\u001b[0m                                                                                \u001b[K\u001b[24;1H\u001b[0m                                                                                \u001b[K\u001b[2 q\u001b[1;1H"]
[4.1,"m","1.1 Fold and unfold"]
[4.1,"o","\u001b[1;1H\u001b[0m** 1.1 Fold and unfold\u001b[K\u001b[2;1H\u001b[0mPut the cursor on the \u001b[0;38;2;179;246;192m=Kitchen=\u001b[0m headline below and press \u001b[0;38;2;179;246;192m=<Tab>=\u001b[0m\u001b[K\u001b[3;1H\u001b[0ma few times: it cycles the subtree between folded, its children and\u001b[K\u001b[4;1H\u001b[0meverything. \u001b[0;38;2;179;246;192m=<S-Tab>=\u001b[0m does the same for the whole file (press\u001b[K\u001b[5;1H\u001b[0mit until everything shows again).\u001b[K\u001b[6;1H\u001b[K\u001b[7;1H\u001b[0mThere is nothing to check here: move on when you are done.\u001b[K\u001b[8;1H\u001b[K\u001b[9;1H\u001b[0;38;2;166;219;255m*** Kitchen\u001b[0m\u001b[K\u001b[10;1H\u001b[0;1m**** Pots\u001b[0m\u001b[K\u001b[11;1H\u001b[0mTwo big ones and a small one.\u001b[K\u001b[12;1H\u001b[0;1m**** Pans\u001b[0m\u001b[K\u001b[13;1H\u001b[0mA frying pan.\u001b[K\u001b[14;1H\u001b[K\u001b[15;1H\u001b[0m** 1.2 Insert a headline \u001b[0;38;2;255;192;185m ✗\u001b[0m\u001b[K\u001b[16;1H\u001b[0mPut the cursor on \u001b[0;38;2;179;246;192m=Apples=\u001b[0m and press \u001b[0;38;2;179;246;192m=<M-CR>=\u001b[0m: a new headline\u001b[K\u001b[17;1H\u001b[0mof the same level opens, in Insert mode (above when the cursor is at the\u001b[K\u001b[18;1H\u001b[0mstart of the line, else below). Type \u001b[0;38;2;179;246;192m=Pears=\u001b[0m and press \u001b[0;38;2;179;246;192m=<Esc>=\u001b[0m.\u001b[K\u001b[19;1H\u001b[0;38;2;179;246;192m=<leader>oih=\u001b[0m does the same.\u001b[K\u001b[20;1H\u001b[K\u001b[21;1H\u001b[0;38;2;166;219;255m*** Fruit\u001b[0m\u001b[K\u001b[22;1H\u001b[0;48;2;79;82;88m basics.org                                                                27:1 \u001b[0m\u001b[K\u001b[1;1H"]
