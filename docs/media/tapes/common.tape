# Shared settings for every tape. Run tapes from the repository root:
#   vhs docs/media/tapes/agenda.tape
Set Shell "bash"
Set FontFamily "BlexMono Nerd Font Mono"
Set FontSize 18
Set Width 1280
Set Height 720
Set Padding 24
Set Framerate 24
Set TypingSpeed 70ms
Set CursorBlink false
Set WindowBar Colorful
Set Theme { "name": "nvim", "background": "#14161b", "foreground": "#e0e2ea", "cursor": "#e0e2ea", "selection": "#4f5258", "black": "#07080d", "red": "#ffc0b9", "green": "#b3f6c0", "yellow": "#fce094", "blue": "#a6dbff", "magenta": "#ffcaff", "cyan": "#8cf8f7", "white": "#eef1f8", "brightBlack": "#4f5258", "brightRed": "#ffc0b9", "brightGreen": "#b3f6c0", "brightYellow": "#fce094", "brightBlue": "#a6dbff", "brightMagenta": "#ffcaff", "brightCyan": "#8cf8f7", "brightWhite": "#eef1f8" }
