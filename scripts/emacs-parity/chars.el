;;; chars.el --- Org's syntax table for non-ASCII characters  -*- lexical-binding: t -*-

;; Write lua/org/ui/chars_data.lua: what Emacs's regexps make of each non-ASCII
;; character in an Org buffer, the tables org.ui.chars looks codepoints up
;; in (ranges of codepoints, from U+0080 on):
;;
;;   SYMBOL   the symbol constituents (no "\\_<" after them)
;;   OTHER    the characters that are neither word nor symbol
;;            constituents (with SYMBOL: [[:punct:]] for a multibyte
;;            character)
;;   JOIN     the characters "\\<" doesn't match between and a Latin
;;            letter after them: word constituents of the Latin script
;;            and combining marks (Emacs's word_boundary_p:
;;            char-script-table and word-combining-categories)
;;   ALNUM    the characters that are [[:alnum:]] and not line-breakable
;;            (\\c|): the ones the radio target links regexp
;;            (org-update-radio-target-regexp) doesn't take as a boundary
;;
;;   scripts/emacs-parity/generate.sh chars

(defun chars-ranges (pred)
  "The ranges (FROM . TO) of the characters from U+0080 for which PRED holds."
  (let ((c #x80) (start nil) (out nil))
    (while (<= c #x10FFFF)
      (let ((yes (and (not (and (>= c #xD800) (<= c #xDFFF))) (funcall pred c))))
        (cond ((and yes (not start)) (setq start c))
              ((and (not yes) start) (push (cons start (1- c)) out) (setq start nil))))
      (setq c (1+ c)))
    (when start (push (cons start #x10FFFF) out))
    (nreverse out)))

(defun chars-lua (ranges)
  "RANGES as the text of a Lua long string: \"FROM-TO\" in hex, a few
per line."
  (let ((items (mapcar (lambda (r) (format "%X-%X" (car r) (cdr r))) ranges))
        (lines '()) (line ""))
    (dolist (it items)
      (if (> (+ (length line) (length it) 1) 100)
          (progn (push line lines) (setq line it))
        (setq line (if (string= line "") it (concat line " " it)))))
    (push line lines)
    (mapconcat #'identity (nreverse lines) "\n")))

(with-temp-buffer
  (org-mode)
  (let ((symbol (chars-ranges (lambda (c) (= (char-syntax c) ?_))))
        (other (chars-ranges (lambda (c) (not (memq (char-syntax c) '(?w ?_))))))
        (join (chars-ranges
               (lambda (c)
                 (and (= (char-syntax c) ?w)
                      (not (string-match-p "\\<a" (string c ?a) 1))))))
        (alnum (chars-ranges
                (lambda (c) (not (string-match-p "[^[:alnum:]]\\|\\c|" (string c)))))))
    (parity-write
     (expand-file-name "lua/org/ui/chars_data.lua" parity-root)
     (concat
      "-- Generated by scripts/emacs-parity/chars.el (Emacs " emacs-version
      ", Org " (org-version) "): don't edit.\n"
      "-- Ranges of codepoints (hex \"FROM-TO\"), looked up by org.ui.chars.\n"
      "return {\n"
      "  -- symbol constituents\n"
      "  SYMBOL = [[\n" (chars-lua symbol) "\n]],\n"
      "  -- neither word nor symbol constituents (punctuation, blanks, parentheses, ...)\n"
      "  OTHER = [[\n" (chars-lua other) "\n]],\n"
      "  -- word constituents after which \"\\\\<\" doesn't match before a Latin letter\n"
      "  JOIN = [[\n" (chars-lua join) "\n]],\n"
      "  -- [[:alnum:]] and not line-breakable (\\\\c|)\n"
      "  ALNUM = [[\n" (chars-lua alnum) "\n]],\n"
      "}\n"))))

(provide 'chars)
;;; chars.el ends here
